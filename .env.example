# ---- Runtime ----
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# ---- Database (Microsoft SQL Server) ----
# Requires SQL Server Authentication (Mixed Mode) on the instance.
# The database name must be URL-encoded ("digital invoice" -> "digital%20invoice").
DATABASE_URL="sqlserver://DB_USER:DB_PASSWORD@localhost:1433;database=digital%20invoice;encrypt=true;trustServerCertificate=true;"

# ---- JWT ----
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
JWT_ISSUER=digital-invoice-api
JWT_AUDIENCE=digital-invoice-web

# ---- Password hashing ----
BCRYPT_ROUNDS=12

# ---- CORS ----
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000

# ---- Auth rate limiting ----
# Max auth requests per 15 minutes per IP (dev default 100, production default 20).
AUTH_RATE_LIMIT_MAX=20
